# API Keys (choose one or both)
# OpenAI for embeddings and GPT models
OPENAI_API_KEY=sk-your-key-here

# Anthropic Claude (recommended for analysis)
ANTHROPIC_API_KEY=your-anthropic-key-here

# Database Configuration
DB_PATH=./data/eddigits.db
VECTOR_DB_PATH=./data/chromadb

# Whisper Configuration
# Model options: tiny, base, small, medium, large
# tiny: fastest, least accurate (~1GB RAM)
# base: good balance (~1GB RAM)
# small: better accuracy (~2GB RAM)
# medium: high accuracy (~5GB RAM)
# large: best accuracy (~10GB RAM)
WHISPER_MODEL=base

# Processing Configuration
CHUNK_SIZE=30        # seconds per text chunk
OVERLAP=5            # seconds overlap between chunks
BATCH_SIZE=8         # number of chunks to process at once

# Embedding Model
# Options:
# - sentence-transformers/all-MiniLM-L6-v2 (fast, good quality)
# - sentence-transformers/all-mpnet-base-v2 (slower, better quality)
# - openai (uses OpenAI API, requires API key)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# LLM for Query Analysis
# Options: claude-3-5-sonnet-20241022, gpt-4, gpt-3.5-turbo
LLM_MODEL=claude-3-5-sonnet-20241022

# Search Configuration
TOP_K=10             # number of results to retrieve
MIN_SIMILARITY=0.5   # minimum similarity score (0-1)

# Logging
LOG_LEVEL=INFO       # DEBUG, INFO, WARNING, ERROR
